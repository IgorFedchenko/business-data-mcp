{
  "$schema": "http://json.schemastore.org/template",
  "author": "Igor Fedchenko",
  "classifications": [
    "MCP",
    "Web",
    "Console"
  ],
  "identity": "IgorFedchenko.BusinessDataMcp.CSharp",
  "name": "Business Data MCP server with scoped tools and human approval",
  "shortName": "business-mcp",
  "sourceName": "BusinessData",
  "preferNameDirectory": true,
  "tags": {
    "language": "C#",
    "type": "project"
  },
  "sources": [
    {
      "source": "./",
      "target": "./",
      "include": [
        "src/**",
        "tests/**",
        "scripts/**",
        "evals/**",
        "*.sln",
        "Directory.Build.props",
        "global.json",
        ".gitignore",
        ".env.example",
        "LICENSE",
        "README.md",
        "CHANGELOG.md",
        "docs/**",
        "examples/**",
        "requirements-dev*",
        "pyproject.toml",
        ".editorconfig",
        ".pre-commit-config.yaml",
        ".gitleaks.toml",
        "Dockerfile",
        ".dockerignore",
        ".github/**",
        "CLAUDE.md",
        "AGENTS.md"
      ],
      "exclude": [
        "**/bin/**",
        "**/obj/**",
        "**/*.db*",
        "**/TestResults/**",
        "docs/implementation-plan.md",
        "docs/verification.md",
        "docs/demo-transcript.json",
        "docs/demo.gif",
        "docs/demo.png"
      ]
    }
  ]
}
