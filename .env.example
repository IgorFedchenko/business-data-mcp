# Copy to .env for HTTP mode. Only local synthetic demo credentials belong here.
# Generate your own keys: openssl rand -hex 32 (run separately for each key).
MCP_DATABASE=.data/business.db
MCP_ALLOW_WRITES=false
MCP_READ_API_KEY=
MCP_WRITE_API_KEY=
MCP_TOOL_LIMIT=30
MCP_HTTP_LIMIT=120
MCP_ALLOWED_ORIGINS=http://localhost:5050,http://127.0.0.1:5050
# Optional: DOTNET_ROOT=/absolute/path/to/a/.NET-8-installation
# Optional safe local tracing; default disabled, no outbound exporter.
MCP_TELEMETRY_CONSOLE=false
